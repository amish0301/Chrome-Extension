{
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Alertify - Custom Reminders",
    "description": "Customized Reminders for Water breaks and much more, we care about your health and wellbeing.",
    "action": {
        "default_title": "Alertify",
        "default_popup": "/public/popup.html"
    },

    "background": {
        "service_worker": "/public/background.js"
    },

    "permissions": [
        "contextMenus", "notifications", "alarms", "scripting", "storage"
    ],

    "icons": {
        "16": "/public/assets/icon-16.png",
        "48": "/public/assets/icon-48.png",
        "128": "/public/assets/icon-128.png"
    }

}